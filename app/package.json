{
  "name": "uptime-monitor",
  "version": "1.0.0",
  "description": "Self-hosted uptime monitor built with Express, with Prometheus metrics and webhook alerts",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --coverage",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.2"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "testEnvironment": "node"
  }
}
