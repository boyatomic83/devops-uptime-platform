# Copy to .env (git-ignored) and fill in the channels you want, then: docker compose up -d
# Every channel is optional; configured ones all receive every alert.

# --- Telegram (free) -------------------------------------------------------
# 1. In Telegram, message @BotFather, send /newbot and follow the prompts -> token
# 2. Open your new bot and send it any message (e.g. "hi")
# 3. Run: make telegram-chat-id  -> prints your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp via CallMeBot (free, third-party, personal use) ---------------
# Follow the setup on https://www.callmebot.com/blog/free-api-whatsapp-messages/
# to get an API key for your own number. Phone in international format, e.g. +919876543210
WHATSAPP_PHONE=
WHATSAPP_CALLMEBOT_APIKEY=

# --- Slack or Discord incoming webhook --------------------------------------
ALERT_WEBHOOK_URL=

# Shared secret between Alertmanager and the app (any random string)
ALERTMANAGER_WEBHOOK_TOKEN=change-me-to-something-random
