{
  "name": "devops-uptime-platform",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "minikube": "none" },
    "ghcr.io/devcontainers-extra/features/kind:1": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "forwardPorts": [3000, 3001, 9090, 9093],
  "portsAttributes": {
    "3000": { "label": "Uptime app", "onAutoForward": "openBrowser" },
    "3001": { "label": "Grafana" },
    "9090": { "label": "Prometheus" },
    "9093": { "label": "Alertmanager" }
  },
  "postCreateCommand": "cd app && npm ci",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "ms-azuretools.vscode-docker", "ms-kubernetes-tools.vscode-kubernetes-tools", "redhat.vscode-yaml"]
    }
  }
}
