{
  "uid": "uptime-overview",
  "title": "Uptime Overview",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat", "title": "Targets up", "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(uptime_monitor_up)", "refId": "A" }]
    },
    {
      "type": "stat", "title": "Targets down", "id": 2,
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [{ "expr": "count(uptime_monitor_up == 0) or vector(0)", "refId": "A" }]
    },
    {
      "type": "stat", "title": "Uptime % (1h)", "id": 3,
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2 } },
      "targets": [{ "expr": "sum by (monitor) (increase(uptime_checks_total{result=\"up\"}[1h])) / sum by (monitor) (increase(uptime_checks_total[1h]))", "legendFormat": "{{monitor}}", "refId": "A" }]
    },
    {
      "type": "state-timeline", "title": "Status timeline", "id": 4,
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ] } },
      "targets": [{ "expr": "uptime_monitor_up", "legendFormat": "{{monitor}}", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "Check latency p95", "id": 5,
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, monitor) (rate(uptime_check_duration_seconds_bucket[5m])))", "legendFormat": "{{monitor}}", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "App HTTP request rate", "id": 6,
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "expr": "sum by (route, status) (rate(http_request_duration_seconds_count[5m]))", "legendFormat": "{{route}} {{status}}", "refId": "A" }]
    }
  ]
}
